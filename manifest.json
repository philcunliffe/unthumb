{
  "manifest_version": 3,
  "name": "Unthumb",
  "version": "1.0.0",
  "description": "Replaces YouTube home thumbnails with a still frame from the video.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://i9.ytimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}

